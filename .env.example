# flavor-lite reads API keys from the environment.
# Fastest start: set one key, run `flavor-lite`.

# OpenAI or any OpenAI-compatible gateway (vLLM, Ollama, DeepSeek, Moonshot, ...)
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com
# FLAVOR_OPENAI_MODEL=deepseek-chat

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# FLAVOR_ANTHROPIC_MODEL=claude-sonnet-4-5

# Explicit model selection ("provider:model" form), overrides provider defaults
# FLAVOR_MODEL=openai:gpt-5

# Activation profile: minimal | coding | full (default: coding)
# FLAVOR_PROFILE=coding

# Transcript budgets; complete oversized outputs are retained as artifacts.
# FLAVOR_MAX_PROMPT_CHARS=48000
# FLAVOR_MAX_TOOL_OUTPUT_CHARS=100000
