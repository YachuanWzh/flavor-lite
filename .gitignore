node_modules/
dist/
*.tgz
.env
.DS_Store

# 临时文件 / 构建产物
*.log
*.tmp
*.bak
*.tsbuildinfo
coverage/
# .flavorlite 数据区（sessions/memory/evolve 等）忽略，但放行插件源码；
# 注意必须用内容级忽略 `.flavorlite/*`，整目录忽略无法被 `!` 穿透。
.flavorlite/*
!.flavorlite/plugins/
# loader 快照为运行时产物，不入库
.flavorlite/plugins/.versions/
.flavor

# Runtime evidence, evaluation, and evolution state
.flavorlite/artifacts/
.flavorlite/evals/
.flavorlite/evolve/budget.json
