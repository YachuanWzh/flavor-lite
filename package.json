{
  "name": "flavor-lite",
  "version": "0.2.0",
  "description": "Everything is a plugin: a lightweight coding agent kernel in the spirit of dsh, with the best of flavor-code and pi.",
  "author": "YachuanWzh",
  "license": "MIT",
  "type": "module",
  "bin": {
    "flavor-lite": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "cli",
    "llm",
    "plugin"
  ]
}
